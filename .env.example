# ============================================================
# Hue Muse Beauty E-commerce — Local Environment Template
# Copy to .env and fill in local values. NEVER commit .env.
# ============================================================

# --- General ---
NODE_ENV=development
APP_NAME=hue-muse-beauty-ecommerce
APP_PORT=3000
API_PORT=4000

# --- Database (local dev only) ---
DATABASE_URL=postgresql://hmb_dev:hmb_dev_password@localhost:5432/hmb_ecommerce_dev

# --- Storage (local dev — MinIO or similar S3-compatible) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=local-access-key
STORAGE_SECRET_KEY=local-secret-key
STORAGE_BUCKET=hmb-ecommerce-dev

# --- Cache / Session Store (Redis — per Phase 8 Technical Architecture) ---
REDIS_URL=redis://localhost:6379

# --- Email (local dev — Mailhog/Maildev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=dev@huemusebeauty.local

# --- Auth (local dev secrets only — see docs/security/SECRET_MANAGEMENT.md) ---
JWT_SECRET=replace-with-local-dev-secret
SESSION_SECRET=replace-with-local-dev-secret

# --- HMEOS Integration (future sprints — placeholders only) ---
# This service integrates with HMEOS strictly via versioned APIs.
# No credentials or endpoints are configured in Sprint 1.
HMEOS_API_BASE_URL=
HMEOS_API_KEY=
