# Sprint 9 — production environment template. Copy to .env.production
# and fill in real values; NEVER commit the filled-in version (matches
# .gitignore's existing *.env* exclusion from Sprint 1).
NODE_ENV=production
API_PORT=4000

# Database — point at a managed Postgres instance in real production,
# not the postgres service in this same compose file (see
# DEPLOYMENT_ARCHITECTURE.md)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hmb_ecommerce_prod
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME_TO_A_REAL_SECRET
POSTGRES_DB=hmb_ecommerce_prod

# Redis
REDIS_URL=redis://:PASSWORD@HOST:6379
REDIS_PASSWORD=CHANGE_ME_TO_A_REAL_SECRET

# Secrets — every one of these is validated as required at boot
# (backend/src/config/env.validation.ts fails fast if missing)
JWT_SECRET=CHANGE_ME_GENERATE_A_REAL_RANDOM_SECRET
SESSION_SECRET=CHANGE_ME_GENERATE_A_REAL_RANDOM_SECRET

# Object storage
STORAGE_ENDPOINT=https://YOUR_S3_OR_MINIO_ENDPOINT
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=hmb-production-media
NEXT_PUBLIC_STORAGE_HOST=YOUR_S3_OR_MINIO_ENDPOINT

# CORS — the real production frontend origin(s), never a wildcard
CORS_ORIGIN=https://www.huemusebeauty.com

# Payment (Sprint 5) — switch away from mock only once real credentials exist
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
